---
/**
 * Rodapé do site: o nome e o CNPJ da empresa e os links do LinkedIn e do GitHub.
 */
import type { Lang } from "../data/format.ts";
import type { Site } from "../data/schema.ts";

/** Propriedades do rodapé. */
interface Props {
  /** Todo o conteúdo do site. */
  site: Site;
  /** Idioma da página. */
  lang: Lang;
}

const { site, lang } = Astro.props;
const year = new Date().getFullYear();
const legalLine = `© ${String(year)} ${site.brand.name} · ${site.ui.footer.companyId[lang]} ${site.contact.cnpj}`;
const links = [
  { href: site.contact.linkedin, label: site.ui.contact.linkedin[lang] },
  { href: site.contact.github, label: site.ui.contact.github[lang] },
];
---

<footer class="footer">
  <div class="container">
    <p>{legalLine}</p>
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="visually-hidden">
              {site.ui.a11y.externalLink[lang]}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.0625rem solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
  }

  .links {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-text-muted);
  }

  .links a:hover {
    color: var(--color-text);
  }
</style>
