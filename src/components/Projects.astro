---
/**
 * Seção de projetos principais: um card por projeto do tipo `main`, com os em
 * andamento primeiro e os outros do mais recente para o mais antigo. Nas telas
 * largas, os cards se encaixam em duas colunas independentes, com o mesmo espaço
 * entre eles, sem buracos quando os textos têm tamanhos diferentes.
 */
import ProjectCard from "./ProjectCard.astro";
import Section from "./Section.astro";
import {
  isMainProject,
  sortProjects,
  withClients,
  type Lang,
} from "../data/format.ts";
import type { Site } from "../data/schema.ts";

/** Propriedades da seção de projetos. */
interface Props {
  /** Todo o conteúdo do site. */
  site: Site;
  /** Idioma da página. */
  lang: Lang;
}

const { site, lang } = Astro.props;
const projects = withClients(
  sortProjects(site.projects.filter(isMainProject)),
  site.clients,
);
---

<Section id="projects" title={site.ui.sections.projects[lang]}>
  <ul class="projects">
    {projects.map(({ project, client }) => (
      <li>
        <ProjectCard
          project={project}
          client={client}
          ui={site.ui}
          lang={lang}
        />
      </li>
    ))}
  </ul>
</Section>

<style>
  .projects {
    padding: 0;
    list-style: none;
  }

  .projects li {
    margin-bottom: var(--space-5);
    break-inside: avoid;
  }

  .projects li:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 64rem) {
    .projects {
      columns: 2;
      column-gap: var(--space-5);
    }
  }
</style>
