---
/**
 * Página inicial completa num idioma: o cabeçalho, as seções na ordem aprovada
 * (hero, sobre, serviços, projetos principais, participação pontual, linha do
 * tempo, skills, formação e certificações, laboratório e contato), o rodapé e o
 * botão de voltar ao topo.
 *
 * As páginas de cada idioma só escolhem o idioma. Os links `hreflang` apontam
 * para as duas versões, com a em português como padrão (`x-default`).
 */
import About from "./About.astro";
import BackToTop from "./BackToTop.astro";
import Contact from "./Contact.astro";
import Education from "./Education.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Lab from "./Lab.astro";
import OccasionalWork from "./OccasionalWork.astro";
import Projects from "./Projects.astro";
import Services from "./Services.astro";
import Skills from "./Skills.astro";
import Timeline from "./Timeline.astro";
import Base from "../layouts/Base.astro";
import {
  homePath,
  htmlLang,
  ogImageSize,
  ogLocale,
  otherLang,
  type Lang,
} from "../data/format.ts";
import { getSite } from "../data/site.ts";

/** Propriedades da página inicial. */
interface Props {
  /** Idioma da página. */
  lang: Lang;
}

const { lang } = Astro.props;
const site = await getSite();
if (Astro.site === undefined) {
  throw new Error("Set site in astro.config.ts to build the hreflang links");
}
const origin = Astro.site;
const alternates = [
  { hreflang: htmlLang.pt, href: new URL(homePath.pt, origin).href },
  { hreflang: htmlLang.en, href: new URL(homePath.en, origin).href },
  { hreflang: "x-default", href: new URL(homePath.pt, origin).href },
];
const image = {
  url: new URL(`/og/${lang}.png`, origin).href,
  alt: `${site.brand.name}: ${site.hero.tagline[lang]}`,
  ...ogImageSize,
};
---

<Base
  lang={htmlLang[lang]}
  title={site.seo.title[lang]}
  description={site.seo.description[lang]}
  alternates={alternates}
  canonical={new URL(homePath[lang], origin).href}
  siteName={site.brand.name}
  ogLocale={ogLocale[lang]}
  ogLocaleAlternate={ogLocale[otherLang(lang)]}
  image={image}
>
  <Header site={site} lang={lang} />
  <main id="main">
    <Hero site={site} lang={lang} />
    <About site={site} lang={lang} />
    <Services site={site} lang={lang} />
    <Projects site={site} lang={lang} />
    <OccasionalWork site={site} lang={lang} />
    <Timeline site={site} lang={lang} />
    <Skills site={site} lang={lang} />
    <Education site={site} lang={lang} />
    <Lab site={site} lang={lang} />
    <Contact site={site} lang={lang} />
  </main>
  <Footer site={site} lang={lang} />
  <BackToTop label={site.ui.a11y.backToTop[lang]} />
</Base>
