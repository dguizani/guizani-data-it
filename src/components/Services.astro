---
/**
 * Seção de serviços: um card por serviço, com o nome e a descrição.
 */
import Section from "./Section.astro";
import type { Lang } from "../data/format.ts";
import type { Site } from "../data/schema.ts";

/** Propriedades da seção de serviços. */
interface Props {
  /** Todo o conteúdo do site. */
  site: Site;
  /** Idioma da página. */
  lang: Lang;
}

const { site, lang } = Astro.props;
---

<Section id="services" title={site.ui.sections.services[lang]}>
  <ul class="services">
    {site.services.map((service) => (
      <li class="service">
        <h3>{service.title[lang]}</h3>
        <p>{service.description[lang]}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .services {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .service {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 0.0625rem solid var(--color-border);
    border-top: 0.1875rem solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  h3 {
    font-size: var(--text-lg);
  }

  p {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
