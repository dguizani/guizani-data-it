---
/**
 * Cabeçalho do site: o link "pular para o conteúdo", o logo, a navegação (só
 * nas telas largas), o seletor de idioma e o botão de tema.
 */
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { homePath, htmlLang, otherLang, type Lang } from "../data/format.ts";
import type { Site } from "../data/schema.ts";

/** Propriedades do cabeçalho. */
interface Props {
  /** Todo o conteúdo do site. */
  site: Site;
  /** Idioma da página. */
  lang: Lang;
}

const { site, lang } = Astro.props;
const target = otherLang(lang);
const links = [
  { href: "#services", label: site.ui.sections.services[lang] },
  { href: "#projects", label: site.ui.sections.projects[lang] },
  { href: "#contact", label: site.ui.sections.contact[lang] },
];
---

<a class="skip-link" href="#main">
  {site.ui.a11y.skipToContent[lang]}
</a>
<header class="header">
  <Logo
    href={homePath[lang]}
    label={site.ui.a11y.home[lang]}
    primary={site.brand.wordmark.primary}
    secondary={site.brand.wordmark.secondary}
  />
  <nav class="nav" aria-label={site.ui.a11y.mainNav[lang]}>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="actions">
    <LanguageSwitch
      href={homePath[target]}
      label={site.ui.language.switchLabel[lang]}
      accessibleName={site.ui.language.switchName[lang]}
      targetLang={htmlLang[target]}
    />
    <ThemeToggle label={site.ui.a11y.themeToggle[lang]} />
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--color-text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 64rem) {
    .nav {
      display: block;
      margin-left: auto;
    }
  }
</style>
