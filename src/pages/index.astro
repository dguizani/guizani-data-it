---
/**
 * Página provisória em português, que mostra a identidade visual (M-004): o
 * logo, o botão de tema, o fundo de circuito e os botões do hero, com os textos
 * do `site.yaml`.
 *
 * É substituída pelas seções do site no M-005; a descrição para os buscadores
 * passa para o `site.yaml` no M-007.
 */
import Base from "../layouts/Base.astro";
import CircuitBackground from "../components/CircuitBackground.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getSite } from "../data/site.ts";

const site = await getSite();
const lang = "pt";
---

<Base
  lang="pt-BR"
  title={site.brand.name}
  description="Guizani Data IT: engenharia de dados. Site novo em construção."
>
  <header class="header">
    <Logo
      href="/"
      label={site.ui.a11y.home[lang]}
      primary={site.brand.wordmark.primary}
      secondary={site.brand.wordmark.secondary}
    />
    <ThemeToggle label={site.ui.a11y.themeToggle[lang]} />
  </header>
  <main>
    <section class="hero">
      <CircuitBackground />
      <div class="hero-content">
        <h1>{site.brand.name}</h1>
        <p class="stack">
          {site.skills
            .flatMap((group) => group.items)
            .slice(0, 6)
            .map((item) => (typeof item === "string" ? item : item[lang]))
            .join(" · ")}
        </p>
        <div class="actions">
          <a class="button primary" href="#contact">
            {site.ui.hero.contactButton[lang]}
          </a>
          <a class="button secondary" href="#projects">
            {site.ui.hero.projectsButton[lang]}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-block: 0.0625rem solid var(--color-border);
  }

  .hero-content {
    position: relative;
    display: grid;
    gap: var(--space-5);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stack {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .secondary {
    border: 0.0625rem solid var(--color-primary);
    color: var(--color-text);
  }
</style>
