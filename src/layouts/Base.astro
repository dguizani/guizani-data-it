---
/**
 * Estrutura comum a todas as páginas: o `<head>` (metadados, canônico, Open
 * Graph, cartão do X, favicon, fontes e o script do tema) e o `<body>` com o
 * conteúdo da página.
 *
 * O script do tema roda no `<head>`, antes da página aparecer, para ela não
 * piscar no tema errado: usa a escolha salva no navegador ou, sem ela, o tema
 * do sistema. Ele também trata o clique em qualquer elemento com
 * `data-theme-toggle`, para o site não precisar de outro script.
 */
import "@fontsource-variable/inter/wght.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/reset.css";

/** Propriedades do layout base. */
interface Props {
  /** Idioma da página, no formato do atributo `lang` (ex.: `pt-BR`, `en`). */
  lang: string;
  /** Título da página, mostrado na aba do navegador e nos buscadores. */
  title: string;
  /** Descrição da página para os buscadores. */
  description: string;
  /** Versões da página em cada idioma, para os links `hreflang` (ex.: `pt-BR`, `en`, `x-default`). */
  alternates: readonly { hreflang: string; href: string }[];
  /** Endereço completo e oficial da página (link canônico e `og:url`). */
  canonical: string;
  /** Nome do site nas prévias de compartilhamento (`og:site_name`). */
  siteName: string;
  /** Idioma da página no formato do Open Graph (ex.: `pt_BR`). */
  ogLocale: string;
  /** Idioma da outra versão da página no formato do Open Graph (ex.: `en_US`). */
  ogLocaleAlternate: string;
  /** Imagem das prévias de compartilhamento: endereço completo, texto alternativo e medidas em pixels. */
  image: { url: string; alt: string; width: number; height: number };
}

const {
  lang,
  title,
  description,
  alternates,
  canonical,
  siteName,
  ogLocale,
  ogLocaleAlternate,
  image,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const key = "theme";
        const root = document.documentElement;
        const readStored = () => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          root.dataset.theme = theme;
        };
        const stored = readStored();
        const system = matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
        apply(stored === "light" || stored === "dark" ? stored : system);
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (
            !(target instanceof Element) ||
            target.closest("[data-theme-toggle]") === null
          ) {
            return;
          }
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          apply(next);
          try {
            localStorage.setItem(key, next);
          } catch {
            return;
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
